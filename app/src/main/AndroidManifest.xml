<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".LogLifeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Loglife">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Loglife">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "Ask first" prompt opened by widget taps. Own task so it closes
             back to the home screen, not into the app. -->
        <activity
            android:name=".ui.widgets.ConfirmTapActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Loglife.Prompt" />

        <!-- Stop / Still going on the session notifications -->
        <receiver
            android:name=".notifications.SessionActionReceiver"
            android:exported="false" />

        <!-- Quick log deck widget -->
        <receiver
            android:name=".ui.widgets.EventLogWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.loglife.action.WIDGET_ITEM_CLICK" />
                <action android:name="com.example.loglife.action.REFRESH_ALL_WIDGETS" />
                <action android:name="com.example.loglife.action.WIDGET_FLIP_NEXT" />
                <action android:name="com.example.loglife.action.WIDGET_FLIP_PREV" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/event_log_widget_info" />
        </receiver>

        <!-- Quick buttons widget -->
        <receiver
            android:name=".ui.widgets.QuickButtonsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.loglife.action.WIDGET_ITEM_CLICK" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_buttons_widget_info" />
        </receiver>

        <!-- Picks the events for one Quick buttons widget. Exported: the
             launcher starts it when the widget is placed or reconfigured. -->
        <activity
            android:name=".ui.widgets.QuickButtonsConfigureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Loglife">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Today widget -->
        <receiver
            android:name=".ui.widgets.TodayStatsWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_stats_widget_info" />
        </receiver>
    </application>

</manifest>