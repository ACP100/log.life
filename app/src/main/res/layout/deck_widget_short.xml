<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log deck, short (4x1, under ~150dp tall): no title row and no
     dots; ‹ › sit beside the tile. Same view ids as deck_widget. -->
<!-- The card is an ImageView layer so its colour (widget theme) and
     opacity can be set from code on every Android version. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wl_card_bg" />

    <LinearLayout
        android:id="@+id/deck_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <ImageView
            android:id="@+id/deck_prev"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="@drawable/wl_btn_bg"
            android:contentDescription="Previous"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_left" />

        <FrameLayout
            android:id="@+id/deck_tile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/deck_tile_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wl_tile_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/deck_tile_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/wl_dot_ring" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/deck_tile_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Coffee"
                        android:textColor="@color/wl_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deck_tile_last"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="last 07:40"
                        android:textColor="@color/wl_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <Chronometer
                    android:id="@+id/deck_tile_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:textColor="@color/wl_on_ink"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/deck_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="4 / 9"
                    android:textColor="@color/wl_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/deck_empty"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/wl_empty_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/deck_empty_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Pick favourites"
                android:textColor="@color/wl_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deck_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="opens log.life"
                android:textColor="@color/wl_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/deck_next"
            android:layout_width="38dp"
            android:layout_height="match_parent"
            android:background="@drawable/wl_btn_bg"
            android:contentDescription="Next"
            android:padding="8dp"
            android:src="@drawable/ic_chevron_right" />
    </LinearLayout>
</FrameLayout>
