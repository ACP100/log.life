<?xml version="1.0" encoding="utf-8"?>
<!-- Today: count + logged time, running sessions as pills with live timers,
     then the latest logs. Rows are added in code. Tap opens the app; + opens
     the quick log picker for anything that isn't a favourite. -->
<!-- The card is an ImageView layer so its colour (widget theme) and
     opacity can be set from code on every Android version. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wl_card_bg" />

    <LinearLayout
        android:id="@+id/today_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/today_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:text="Today"
                android:textColor="@color/wl_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/today_stats"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:fontFamily="monospace"
                android:gravity="end"
                android:maxLines="1"
                android:text="0 logs"
                android:textColor="@color/wl_muted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/today_add"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/wl_btn_bg"
                android:contentDescription="Log something"
                android:padding="6dp"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/today_running"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/today_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/today_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Nothing logged yet"
            android:textColor="@color/wl_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
