<?xml version="1.0" encoding="utf-8"?>
<!-- Quick log deck, regular size (4x2 and up). One tile at a time, stepped
     with ‹ ›. Per-event colours are tinted in code (WidgetStyle); static
     chrome uses wl_* colours with night variants. No ?attr references:
     the launcher process inflates this. -->
<!-- The card is an ImageView layer so its colour (widget theme) and
     opacity can be set from code on every Android version. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/wl_card_bg" />

    <LinearLayout
        android:id="@+id/deck_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/deck_eyebrow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:paddingStart="2dp"
                android:text="QUICK LOG"
                android:textColor="@color/wl_muted"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deck_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="4 / 9"
                android:textColor="@color/wl_muted"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/deck_refresh"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:contentDescription="Refresh widget"
                android:padding="7dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/deck_tile"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/deck_tile_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/wl_tile_bg" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/deck_tile_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/wl_dot_ring" />

                    <TextView
                        android:id="@+id/deck_tile_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Coffee"
                        android:textColor="@color/wl_ink"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/deck_tile_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/wl_chip_bg"
                        android:maxLines="1"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="Food"
                        android:textColor="@color/wl_ink"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <Chronometer
                        android:id="@+id/deck_tile_timer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:autoSizeMaxTextSize="38sp"
                        android:autoSizeMinTextSize="14sp"
                        android:autoSizeTextType="uniform"
                        android:fontFamily="monospace"
                        android:gravity="bottom|start"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/wl_on_ink"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/deck_tile_last"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:text="last 07:40"
                        android:textColor="@color/wl_muted"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/deck_tile_hint_icon"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="6dp"
                        android:layout_marginBottom="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_play_small"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/deck_tile_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Tap to log"
                        android:textColor="@color/wl_ink"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Nothing running and no favourites: opens the app's widget settings. -->
        <LinearLayout
            android:id="@+id/deck_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:background="@drawable/wl_empty_bg"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/deck_empty_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Pick favourites"
                android:textColor="@color/wl_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/deck_empty_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="opens log.life"
                android:textColor="@color/wl_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/deck_nav"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/deck_prev"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/wl_btn_bg"
                android:contentDescription="Previous"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_left" />

            <!-- One deck_dot per tile, added in code. -->
            <LinearLayout
                android:id="@+id/deck_dots"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal" />

            <ImageView
                android:id="@+id/deck_next"
                android:layout_width="44dp"
                android:layout_height="36dp"
                android:background="@drawable/wl_btn_bg"
                android:contentDescription="Next"
                android:padding="9dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
